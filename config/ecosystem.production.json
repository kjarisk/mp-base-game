{
  "apps": [
    {
      "name": "mp-base-game",
      "script": "backend/server.js", 
      "cwd": "/root/mp-base-game",
      "instances": 2,
      "exec_mode": "cluster",
      "watch": false,
      "env_file": "config/.env.production",
      "env": {
        "NODE_ENV": "production",
        "PORT": 3000
      },
      "error_file": "logs/prod-err.log",
      "out_file": "logs/prod-out.log", 
      "log_file": "logs/prod-combined.log",
      "time": true,
      "max_restarts": 10,
      "min_uptime": "10s",
      "kill_timeout": 5000
    }
  ]
}
