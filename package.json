{
  "name": "multiplayer-game-starter",
  "version": "1.0.0",
  "description": "A simple multiplayer game starter",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "NODE_ENV=development nodemon backend/server.js",
    "dev:full": "concurrently \"npm run dev\" \"npm run dev:frontend\"",
    "dev:frontend": "npx http-server frontend/public -p 8080 -c-1 --cors",
    "test": "NODE_ENV=test mocha test/**/*.test.js",
    "migrate": "chmod +x scripts/migrate.sh && ./scripts/migrate.sh"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^17.0.1",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "pg": "^8.16.3",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "http-server": "^14.1.1",
    "mocha": "^11.5.0",
    "nodemon": "^3.1.10"
  },
  "keywords": [
    "multiplayer",
    "game",
    "websockets",
    "real-time",
    "canvas",
    "javascript"
  ],
  "author": "Your Name",
  "license": "MIT"
}
