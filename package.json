{
  "name": "multiplayer-game-starter",
  "version": "1.0.0",
  "description": "A multiplayer game starter with modern backend architecture",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "NODE_ENV=development node backend/server.js",
    "test": "NODE_ENV=test mocha test/**/*.test.js",
    "test:watch": "NODE_ENV=test mocha test/**/*.test.js --watch",
    "migrate": "chmod +x scripts/migrate.sh && ./scripts/migrate.sh",
    "migrate:test": "chmod +x scripts/migrate.sh && ./scripts/migrate.sh test",
    "migrate:prod": "chmod +x scripts/migrate.sh && ./scripts/migrate.sh production",
    "deploy:test": "pm2 start config/ecosystem.test.json",
    "deploy:prod": "pm2 start config/ecosystem.production.json",
    "logs": "pm2 logs",
    "health": "curl -f http://localhost:3000/health || echo 'Server not responding'"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "pg": "^8.16.3",
    "phaser": "^3.90.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "mocha": "^11.5.0"
  },
  "keywords": [
    "multiplayer",
    "game",
    "websockets",
    "express",
    "node.js"
  ],
  "author": "Your Name",
  "license": "MIT"
}
